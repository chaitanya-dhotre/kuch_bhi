<!--
  Rive spike, 2026-11-07. A deliberately rough capybara proving the pipeline:
  custom cubic body path skinned to two bones (neck bends), gradient fill,
  feathered ground shadow, yuzu on the head, breathe + blink loops, and a
  `happy` view-model boolean driving a Mood layer. Built with Rive CLI 1.9.1,
  verified headless and run on the M52 + Redmi S2 via the rive 0.14.11 Flutter
  package. Not final art: a working starting point for Page 10 Phase 1.
  Project layout to rebuild: rive.yaml (`name: capytest`) + this file as scene.rml.
-->
<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:41" styleId="0:5" width="400" height="300" name="Capy" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Head bone subtree first: first declared paints on top. -->
        <RootBone x="170" y="170" length="90" rotation="0" name="Back" id="0:20">
            <Bone length="50" rotation="0" name="Head" id="0:21">
                <!-- Children of the Head bone are in its local space: origin at world (260,170). -->
                <Shape x="15" y="-72" name="Yuzu" id="0:30">
                    <Ellipse width="30" height="27" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <RadialGradient startX="-5" startY="-5" endX="16" endY="16" name="G">
                            <GradientStop colorValue="FFFFC24D" position="0"/>
                            <GradientStop colorValue="FFE8961E" position="1"/>
                        </RadialGradient>
                    </Fill>
                </Shape>
                <Shape x="20" y="-87" rotation="0.6" name="Leaf" id="0:31">
                    <Ellipse width="12" height="6" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF6E9B4A" name="C"/></Fill>
                </Shape>

                <Shape x="28" y="-20" name="EyeOpen" id="0:32">
                    <Ellipse width="10" height="11" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF3B2A1E" name="C"/></Fill>
                </Shape>
                <Shape x="28" y="-20" opacity="0" name="EyeHappy" id="0:33">
                    <PointsPath isClosed="false" name="Path">
                        <StraightVertex x="-6" y="2"/>
                        <CubicMirroredVertex x="0" y="-4" rotation="0" distance="3"/>
                        <StraightVertex x="6" y="2"/>
                    </PointsPath>
                    <Stroke thickness="3" cap="round" join="round" name="S">
                        <SolidColor colorValue="FF3B2A1E" name="C"/>
                    </Stroke>
                </Shape>

                <Shape x="56" y="22" name="Snout" id="0:34">
                    <Rectangle width="40" height="50" cornerRadiusTL="18" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF8B5E3C" name="C"/></Fill>
                </Shape>
                <Shape x="56" y="30" name="Smile" id="0:35">
                    <PointsPath isClosed="false" name="Path">
                        <StraightVertex x="-9" y="0"/>
                        <CubicMirroredVertex x="0" y="6" rotation="0" distance="5"/>
                        <StraightVertex x="9" y="0"/>
                    </PointsPath>
                    <Stroke thickness="3" cap="round" name="S">
                        <SolidColor colorValue="FF5C3A22" name="C"/>
                    </Stroke>
                </Shape>
                <Shape x="8" y="-56" name="Ear" id="0:36">
                    <Ellipse width="18" height="15" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFB27A42" name="C"/></Fill>
                </Shape>
            </Bone>
        </RootBone>

        <!-- Body: one custom path, skinned to both bones so the neck bends. -->
        <Shape x="0" y="0" name="Body" id="0:10">
            <PointsPath isClosed="true" isClockwise="true" name="Path" id="0:11">
                <CubicMirroredVertex x="120" y="130" rotation="-0.35" distance="40">
                    <CubicWeight values="255" indices="1" inValues="255" inIndices="1" outValues="255" outIndices="1"/>
                </CubicMirroredVertex>
                <CubicMirroredVertex x="250" y="108" rotation="0.15" distance="45">
