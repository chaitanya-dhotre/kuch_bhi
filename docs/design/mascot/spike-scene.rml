                </CubicMirroredVertex>
                <Skin tx="0" ty="0" name="Skin">
                    <Tendon boneId="0:20" tx="170" ty="170" name="BackT"/>
                    <Tendon boneId="0:21" tx="260" ty="170" name="HeadT"/>
                </Skin>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="200" startY="105" endX="200" endY="235" name="G">
                    <GradientStop colorValue="FFD09659" position="0"/>
                    <GradientStop colorValue="FFB27A42" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- Legs behind the body. -->
