            <StateMachineLayer name="Blink" id="0:9">
                <EntryState><StateTransition stateToId="0:61"/></EntryState>
                <AnimationState animationId="0:51" id="0:61"/>
            </StateMachineLayer>
            <StateMachineLayer name="Mood" id="0:15">
                <EntryState><StateTransition stateToId="0:62"/></EntryState>
                <AnimationState x="200" animationId="0:52" id="0:62">
                    <StateTransition stateToId="0:63" duration="150">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
