        </Shape>
        <Shape x="270" y="236" name="LegFront" id="0:13">
            <Rectangle width="30" height="18" cornerRadiusTL="8" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFB27A42" name="C"/></Fill>
        </Shape>

        <!-- Soft ground shadow. A feathered Fill needs fillRule="clockwise". -->
        <Shape x="205" y="250" name="Shadow" id="0:14">
            <Ellipse width="230" height="20" originX="0.5" originY="0.5" name="Path"/>
