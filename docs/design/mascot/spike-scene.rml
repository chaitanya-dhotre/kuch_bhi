                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" animationId="0:53" id="0:63">
                    <StateTransition stateToId="0:62" duration="150">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
